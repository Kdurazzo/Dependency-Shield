{
  "info": {
    "_postman_id": "a1e9c7d4-8f3b-4122-8051-de9541e289f0",
    "name": "DepShield REST API",
    "description": "# DepShield REST API Collection\n\nDepShield is a lightweight, zero-host-dependency software supply chain security auditor and package vulnerability intelligence service.\n\n### Collection Variables:\n- ****: Host and port of the target service. Default is  (direct backend API) or  (dashboard reverse proxy).\n- ****: Optional NIST National Vulnerability Database API key for elevated CVSS rating limits.\n- ****: Optional Google Gemini API key used for automated vulnerability remediation guides and upgrade impact analysis.\n\n### Authentication:\nAuthentication is passed per-request using the custom request headers  and .",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL of the DepShield service (http://localhost:8000 for backend, http://localhost:8080 for dashboard proxy)"
    },
    {
      "key": "nvdApiKey",
      "value": "",
      "type": "string",
      "description": "Optional NIST NVD REST API key (https://nvd.nist.gov/developers/request-an-api-key)"
    },
    {
      "key": "geminiApiKey",
      "value": "",
      "type": "string",
      "description": "Optional Google Gemini API Key (https://aistudio.google.com/)"
    }
  ],
